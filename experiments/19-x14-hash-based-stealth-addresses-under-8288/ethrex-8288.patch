diff --git a/crates/blockchain/eip8288_block.rs b/crates/blockchain/eip8288_block.rs
new file mode 100644
index 000000000..0048300cb
--- /dev/null
+++ b/crates/blockchain/eip8288_block.rs
@@ -0,0 +1,218 @@
+//! EIP-8288's block validity rule (Draft, ethereum/EIPs master as read on 2026-11-04), patched in
+//! for experiment 19 of exp-e2e-frames; off unless `X14_EIP8288` is set.
+//!
+//! A block is valid only if a proof covers `dependencies(block)`. The block's leanSPHINCS
+//! dependencies are aggregated by leanVM's own aggregation into one proof, serialized without the
+//! keys, which the client takes from the block; under the experiment's extension each leanSTARK
+//! dependency's proof is checked directly, the program found by its keccak256. leanVM runs as the
+//! experiment's prover binary (`X14_PROVER`), since it needs a newer Rust than ethrex pins.
+//!
+//! The proof travels beside the block, under `X14_WITNESS_DIR/sidecar/<deps hash>/`, rather than
+//! in a new header field: the builder writes it when the payload is handed out, and the import
+//! path checks it. Witnesses arrive as files the experiment writes first, standing in for the
+//! EIP's mode-0 wrapper: `w-<dependency key>.json` (a leanSPHINCS signature) or `.bin` (a leanSTARK
+//! proof). A file `corrupt` holding `omit` or `other` makes the next proof cover the block's
+//! dependencies less one, or other dependencies (`other.json`, a signature by another key on
+//! another message; or `other.bin`, a proof of another statement): the experiment's bad blocks.
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::Instant;
+
+use ethrex_common::types::eip8288::{self, LEANSPHINCS_SCHEME, LEANSTARK_SCHEME, Triple};
+use ethrex_common::types::{Block, Transaction};
+use tracing::{info, warn};
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+fn witness_dir() -> PathBuf {
+    PathBuf::from(std::env::var("X14_WITNESS_DIR").unwrap_or_else(|_| "x14-witnesses".to_string()))
+}
+fn prover() -> String {
+    std::env::var("X14_PROVER").unwrap_or_else(|_| "x14-prover".to_string())
+}
+fn record(file: &str, line: String) {
+    use std::io::Write;
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(witness_dir().join(file)) {
+        let _ = writeln!(f, "{line}");
+    }
+}
+
+/// `dependencies(block)`: every frame transaction's dependencies, deduplicated and sorted.
+pub fn dependencies(block: &Block) -> Vec<Triple> {
+    let mut deps: Vec<Triple> = block
+        .body
+        .transactions
+        .iter()
+        .filter_map(|tx| match tx {
+            Transaction::FrameTransaction(f) => Some(eip8288::dependencies(f)),
+            _ => None,
+        })
+        .flatten()
+        .collect();
+    deps.sort();
+    deps.dedup();
+    deps
+}
+
+fn sidecar(deps: &[Triple]) -> PathBuf {
+    witness_dir().join("sidecar").join(hex(&eip8288::deps_hash(deps)))
+}
+fn run(args: &[&str]) -> (bool, String) {
+    match Command::new(prover()).args(args).output() {
+        Ok(o) => {
+            let out = String::from_utf8_lossy(&o.stdout).trim().to_string();
+            (o.status.success() && !out.contains("\"error\""), out)
+        }
+        Err(e) => (false, format!("{{\"error\":\"cannot run the prover: {e}\"}}")),
+    }
+}
+
+/// The builder's half: the proof for a block it hands out. Missing witnesses are logged; the
+/// block will then fail its own import.
+pub fn build_proof(block: &Block) {
+    if eip8288::setting().is_none() {
+        return;
+    }
+    let deps = dependencies(block);
+    if deps.is_empty() {
+        return;
+    }
+    let started = Instant::now();
+    let dir = sidecar(&deps);
+    let _ = std::fs::remove_dir_all(&dir);
+    if std::fs::create_dir_all(&dir).is_err() {
+        warn!("EIP-8288: cannot create {}", dir.display());
+        return;
+    }
+    let corrupt_file = witness_dir().join("corrupt");
+    let corrupt = std::fs::read_to_string(&corrupt_file).ok().map(|s| s.trim().to_string());
+    if corrupt.is_some() {
+        let _ = std::fs::remove_file(&corrupt_file);
+    }
+    let mut sphincs: Vec<&Triple> = deps.iter().filter(|t| t.0 == LEANSPHINCS_SCHEME).collect();
+    let mut starks: Vec<&Triple> = deps.iter().filter(|t| t.0 == LEANSTARK_SCHEME).collect();
+    if corrupt.as_deref() == Some("omit") {
+        if starks.is_empty() { sphincs.pop(); } else { starks.pop(); }
+    }
+    let mut claims: Vec<String> = Vec::new();
+    for t in &sphincs {
+        match std::fs::read_to_string(witness_dir().join(format!("w-{}.json", hex(&eip8288::dependency_key(t))))) {
+            Ok(w) => claims.push(w.trim().to_string()),
+            Err(_) => warn!("EIP-8288: no witness for a leanSPHINCS dependency"),
+        }
+    }
+    // `other`: the leanSPHINCS claims replaced by another key's signature on another message, or,
+    // in a block of leanSTARK dependencies only, the first proof replaced by a proof of another
+    // statement (`other.bin`).
+    let mut other_stark = false;
+    if corrupt.as_deref() == Some("other") {
+        if sphincs.is_empty() {
+            other_stark = true;
+        } else {
+            claims = std::fs::read_to_string(witness_dir().join("other.json")).map(|w| vec![w.trim().to_string()]).unwrap_or_default();
+        }
+    }
+    let mut aggregate = String::from("none");
+    if !claims.is_empty() {
+        let claims_file = dir.join("claims.json");
+        let _ = std::fs::write(&claims_file, format!("[{}]", claims.join(",")));
+        let out = dir.join("aggregate.bin");
+        let (_, o) = run(&["aggregate", &claims_file.to_string_lossy(), &out.to_string_lossy()]);
+        let _ = std::fs::remove_file(&claims_file);
+        aggregate = o;
+    }
+    for (i, t) in starks.iter().enumerate() {
+        let key = hex(&eip8288::dependency_key(t));
+        let from = if other_stark && i == 0 { witness_dir().join("other.bin") } else { witness_dir().join(format!("w-{key}.bin")) };
+        if std::fs::copy(from, dir.join(format!("stark-{key}.bin"))).is_err() {
+            warn!("EIP-8288: no witness for a leanSTARK dependency");
+        }
+    }
+    let line = format!(
+        "{{\"block\":{},\"dependencies\":{},\"leanSphincs\":{},\"leanStark\":{},\"corrupt\":{},\"aggregate\":{},\"ms\":{}}}",
+        block.header.number,
+        deps.len(),
+        sphincs.len(),
+        starks.len(),
+        corrupt.map_or("null".to_string(), |c| format!("\"{c}\"")),
+        if aggregate.starts_with('{') { aggregate } else { "null".to_string() },
+        started.elapsed().as_millis()
+    );
+    info!("EIP-8288: built a block proof {line}");
+    record("builds.jsonl", line);
+}
+
+fn find_program(vk: &[u8; 32]) -> Option<PathBuf> {
+    let dir = std::env::var("X14_PROGRAMS").ok()?;
+    std::fs::read_dir(dir).ok()?.flatten().map(|e| e.path()).find(|p| {
+        p.extension().is_some_and(|x| x == "py")
+            && std::fs::read(p).is_ok_and(|b| ethrex_common::utils::keccak(b).0 == *vk)
+    })
+}
+fn cells(d: &[u8; 32]) -> String {
+    let limb = |o: usize| format!("{:x}", u64::from_le_bytes(d[o..o + 8].try_into().expect("8 bytes")));
+    format!("[[\"{}\",\"{}\"],[\"{}\",\"{}\"]]", limb(0), limb(8), limb(16), limb(24))
+}
+fn check(deps: &[Triple], dir: &Path) -> Result<(), String> {
+    if !dir.exists() {
+        return Err("no proof for the block's dependencies".to_string());
+    }
+    let sphincs: Vec<&Triple> = deps.iter().filter(|t| t.0 == LEANSPHINCS_SCHEME).collect();
+    if !sphincs.is_empty() {
+        let proof = dir.join("aggregate.bin");
+        if !proof.exists() {
+            return Err("no aggregate proof for the block's leanSPHINCS dependencies".to_string());
+        }
+        let claims = dir.join("check-claims.json");
+        let body: Vec<String> = sphincs
+            .iter()
+            .map(|t| format!("{{\"publicKey\":\"{}\",\"message\":\"{}\"}}", hex(&t.2), hex(&t.1)))
+            .collect();
+        std::fs::write(&claims, format!("[{}]", body.join(","))).map_err(|e| e.to_string())?;
+        let (ok, out) = run(&["verify-aggregate", &proof.to_string_lossy(), &claims.to_string_lossy()]);
+        if !ok {
+            return Err(format!("the aggregate proof does not cover the block's leanSPHINCS dependencies: {out}"));
+        }
+    }
+    for t in deps.iter().filter(|t| t.0 == LEANSTARK_SCHEME) {
+        let key = hex(&eip8288::dependency_key(t));
+        let proof = dir.join(format!("stark-{key}.bin"));
+        if !proof.exists() {
+            return Err(format!("no proof for leanSTARK dependency {key}"));
+        }
+        let program = find_program(&t.2).ok_or_else(|| format!("no program whose key is {}", hex(&t.2)))?;
+        let public = dir.join(format!("public-{key}.json"));
+        std::fs::write(&public, cells(&t.1)).map_err(|e| e.to_string())?;
+        let (ok, out) = run(&["verify", &program.to_string_lossy(), &public.to_string_lossy(), &proof.to_string_lossy()]);
+        if !ok {
+            return Err(format!("leanSTARK dependency {key} does not verify: {out}"));
+        }
+    }
+    Ok(())
+}
+
+/// The client's half: a block is valid only if its proof covers `dependencies(block)`.
+pub fn check_block(block: &Block) -> Result<(), String> {
+    if eip8288::setting().is_none() {
+        return Ok(());
+    }
+    let deps = dependencies(block);
+    if deps.is_empty() {
+        return Ok(());
+    }
+    let started = Instant::now();
+    let result = check(&deps, &sidecar(&deps));
+    let line = format!(
+        "{{\"block\":{},\"hash\":\"{:#x}\",\"dependencies\":{},\"valid\":{},\"reason\":{},\"ms\":{}}}",
+        block.header.number,
+        block.hash(),
+        deps.len(),
+        result.is_ok(),
+        result.as_ref().err().map_or("null".to_string(), |e| format!("{:?}", e)),
+        started.elapsed().as_millis()
+    );
+    info!("EIP-8288: checked a block {line}");
+    record("checks.jsonl", line);
+    result
+}
