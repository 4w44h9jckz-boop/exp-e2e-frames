diff --git a/crates/common/types/eip8288.rs b/crates/common/types/eip8288.rs
new file mode 100644
index 000000000..29d07fbad
--- /dev/null
+++ b/crates/common/types/eip8288.rs
@@ -0,0 +1,143 @@
+//! EIP-8288 (Draft, ethereum/EIPs master as read on 2026-11-04), patched in for experiment 19 of
+//! exp-e2e-frames. Off unless `X14_EIP8288` is set:
+//!
+//! - `written`: the EIP as written. A frame of mode 4 is a dependency verification frame;
+//!   `LEANSPHINCS_SCHEME` is its only valid scheme, `LEANSTARK_SCHEME` being reserved.
+//! - `extended`: the experiment's extension. `LEANSTARK_SCHEME` is valid too, and the dependency
+//!   hash puts each dependency's scheme byte first.
+//!
+//! `DEPS_HASH` is Keccak-256, the experiment's choice for a constant the EIP leaves TBD.
+use std::sync::OnceLock;
+
+use super::{Frame, FrameTransaction};
+use crate::utils::keccak;
+
+pub const DEP_VERIFY_FRAME_MODE: u8 = 4;
+pub const MAX_DEPENDENCIES_PER_FRAME: usize = 256;
+pub const LEANSPHINCS_SCHEME: u8 = 0x10;
+pub const LEANSTARK_SCHEME: u8 = 0x11;
+pub const LEANSPHINCS_VERIFICATION_GAS: u64 = 3_000;
+pub const LEANSTARK_VERIFICATION_GAS: u64 = 30_000;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Setting {
+    Written,
+    Extended,
+}
+
+/// The switch, read once from `X14_EIP8288`.
+pub fn setting() -> Option<Setting> {
+    static SETTING: OnceLock<Option<Setting>> = OnceLock::new();
+    *SETTING.get_or_init(|| match std::env::var("X14_EIP8288").as_deref() {
+        Ok("written") => Some(Setting::Written),
+        Ok("extended") => Some(Setting::Extended),
+        _ => None,
+    })
+}
+
+/// `(scheme, data_hash, verification_key_hash)`.
+pub type Triple = (u8, [u8; 32], [u8; 32]);
+
+/// `frame.data_triples`: the frame's data in 96-byte chunks, the scheme its 32nd byte.
+pub fn data_triples(data: &[u8]) -> Vec<Triple> {
+    data.chunks(96)
+        .filter(|c| c.len() == 96)
+        .map(|c| {
+            (c[31], c[32..64].try_into().expect("32 bytes"), c[64..96].try_into().expect("32 bytes"))
+        })
+        .collect()
+}
+
+/// The EIP's validity constraints on one dependency verification frame. `previous_batches` is
+/// whether the preceding frame carries the atomic batch flag.
+pub fn check_frame(i: usize, frame: &Frame, previous_batches: bool) -> Result<(), String> {
+    let setting = setting().ok_or_else(|| format!("Frame {i}: reserved execution mode 4"))?;
+    if frame.data.is_empty() || frame.data.len() % 96 != 0 {
+        return Err(format!("Frame {i}: dependency data must be 96*k bytes, got {}", frame.data.len()));
+    }
+    let triples = data_triples(&frame.data);
+    if triples.len() > MAX_DEPENDENCIES_PER_FRAME {
+        return Err(format!("Frame {i}: more than {MAX_DEPENDENCIES_PER_FRAME} dependencies"));
+    }
+    let mut execution: u64 = 0;
+    for (k, chunk) in frame.data.chunks(96).enumerate() {
+        if chunk[..31].iter().any(|&b| b != 0) {
+            return Err(format!("Frame {i}: dependency {k}: the scheme's first 31 bytes must be zero"));
+        }
+        execution = execution.saturating_add(match (chunk[31], setting) {
+            (LEANSPHINCS_SCHEME, _) => LEANSPHINCS_VERIFICATION_GAS,
+            (LEANSTARK_SCHEME, Setting::Extended) => LEANSTARK_VERIFICATION_GAS,
+            (LEANSTARK_SCHEME, Setting::Written) => {
+                return Err(format!(
+                    "Frame {i}: dependency {k}: LEANSTARK_SCHEME is reserved (EIP-8288 as written)"
+                ));
+            }
+            (other, _) => return Err(format!("Frame {i}: dependency {k}: unknown scheme {other:#04x}")),
+        });
+    }
+    if frame.target.is_some() {
+        return Err(format!("Frame {i}: a dependency frame's target must be absent"));
+    }
+    if !frame.value.is_zero() {
+        return Err(format!("Frame {i}: a dependency frame's value must be 0"));
+    }
+    if frame.flags != 0 {
+        return Err(format!("Frame {i}: a dependency frame's flags must be 0"));
+    }
+    if previous_batches {
+        return Err(format!("Frame {i}: a dependency frame must not be part of an atomic batch"));
+    }
+    if frame.gas_limit != execution {
+        return Err(format!(
+            "Frame {i}: a dependency frame's execution limit must be {execution}, got {}",
+            frame.gas_limit
+        ));
+    }
+    if frame.state_gas_limit != 0 {
+        return Err(format!("Frame {i}: a dependency frame's state limit must be 0"));
+    }
+    Ok(())
+}
+
+/// `dependencies(tx)`: every dependency frame's triples, a zero data hash standing for the
+/// transaction's signature hash, deduplicated and sorted.
+pub fn dependencies(tx: &FrameTransaction) -> Vec<Triple> {
+    if setting().is_none() {
+        return Vec::new();
+    }
+    let mut deps: Vec<Triple> = tx
+        .frames
+        .iter()
+        .filter(|f| f.mode == DEP_VERIFY_FRAME_MODE)
+        .flat_map(|f| data_triples(&f.data))
+        .map(|(s, d, v)| {
+            let d = if d == [0u8; 32] { tx.compute_sig_hash().0 } else { d };
+            (s, d, v)
+        })
+        .collect();
+    deps.sort();
+    deps.dedup();
+    deps
+}
+
+/// `get_deps_hash`: Keccak-256 over `data_hash || verification_key_hash` per dependency, as
+/// written; extended, each dependency's scheme byte goes first.
+pub fn deps_hash(deps: &[Triple]) -> [u8; 32] {
+    let mut bytes = Vec::with_capacity(deps.len() * 65);
+    for (s, d, v) in deps {
+        if setting() == Some(Setting::Extended) {
+            bytes.push(*s);
+        }
+        bytes.extend_from_slice(d);
+        bytes.extend_from_slice(v);
+    }
+    keccak(bytes).0
+}
+
+/// One dependency's own key, under which its witness is handed in: Keccak-256 of its 65 bytes.
+pub fn dependency_key(t: &Triple) -> [u8; 32] {
+    let mut bytes = vec![t.0];
+    bytes.extend_from_slice(&t.1);
+    bytes.extend_from_slice(&t.2);
+    keccak(bytes).0
+}
