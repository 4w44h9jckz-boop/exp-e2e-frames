#!/usr/bin/env bash
# INTMAX3's test runs `anvil` from PATH. For a run on the local chain, reproduce.sh puts this
# directory first on PATH, so the test starts launcher.ts instead, with anvil's arguments.
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
exec node "$root/node_modules/tsx/dist/cli.mjs" "$here/../launcher.ts" "$@"
