   /////////////////// END OF OUTPUT SIGNALS ///////////////////
 
   // 1. Compute existing commitment
+  // Experiment 34, arm B: the note's secret is Poseidon(T, ownerSalt), T = ownerTagHi * 2^128 + ownerTagLo.
+  component ownerSecret = Poseidon(2);
+  ownerSecret.inputs[0] <== ownerTagHi * 340282366920938463463374607431768211456 + ownerTagLo;
