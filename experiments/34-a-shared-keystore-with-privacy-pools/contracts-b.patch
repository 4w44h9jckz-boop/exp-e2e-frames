+
+  /**
+   * @notice Experiment 34, arm B: the owner tag T = ownerTagHi * 2^128 + ownerTagLo is used once,
+   *         and the ownership checker must accept T, the context, the recipient and the relay fee
+   */
+  function _checkOwner(Withdrawal memory _withdrawal, ProofLib.WithdrawProof memory _proof) internal {
+    uint256 _hi = _proof.pubSignals[8];
+    uint256 _lo = _proof.pubSignals[9];
+    if (_hi >= 2 ** 128 || _lo >= 2 ** 128) revert OwnerTagOutOfRange();
+    bytes32 _tag = bytes32((_hi << 128) | _lo);
+    if (usedOwnerTags[_tag]) revert OwnerTagAlreadyUsed();
+    usedOwnerTags[_tag] = true;
+    address _recipient = _withdrawal.processooor;
+    uint256 _fee;
+    if (_recipient == address(ENTRYPOINT)) {
+      IEntrypoint.RelayData memory _data = abi.decode(_withdrawal.data, (IEntrypoint.RelayData));
+      _recipient = _data.recipient;
+      _fee = _data.relayFeeBPS;
+    }
+    (bool _ok,) = OWNER_CHECK.staticcall(abi.encode(_tag, _proof.context(), _recipient, _fee));
+    if (!_ok) revert OwnerCheckFailed();
+  }
 
