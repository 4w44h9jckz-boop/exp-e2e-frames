+        // chain can pass EIP-8272's 8,191-slot window without waiting for it.
+        if let Ok(path) = std::env::var("X33_SLOT_SKIP_FILE") {
+            if let Some(n) = std::fs::read_to_string(&path).ok().and_then(|s| s.trim().parse::<u64>().ok()) {
+                if n > 0 {
+                    slot_number += n;
+                    let _ = std::fs::write(&path, "0");
+                    tracing::info!("Experiment 33: slot skip of {n}, next slot {slot_number}");
+                }
+            }
+        }
 
