+/// The writes the executed transaction made: the VM's state transitions, each
+/// field compared with the head the simulation ran against.
+fn collect_writes(
+    context: &RpcApiContext,
+    header: &BlockHeader,
+    vm: &mut ethrex_vm::Evm,
+) -> Result<Vec<AccountWrite>, RpcErr> {
+    let before_db = StoreVmDatabase::new(context.storage.clone(), header.clone())?;
+    let updates = vm.get_state_transitions().map_err(RpcErr::from)?;
+    let pair = |a: String, b: String| if a == b { None } else { Some([a, b]) };
+    let mut out = Vec::new();
+    for update in updates {
+        let prior = before_db
+            .get_account_state(update.address)
+            .map_err(RpcErr::from)?;
+        let (balance0, nonce0, code0) = match &prior {
+            Some(state) => (state.balance, state.nonce, state.code_hash),
+            None => (U256::zero(), 0, *ethrex_common::constants::EMPTY_KECCAK_HASH),
+        };
+        let (balance1, nonce1, code1) = match &update.info {
+            Some(info) => (info.balance, info.nonce, info.code_hash),
+            None if update.removed => (U256::zero(), 0, *ethrex_common::constants::EMPTY_KECCAK_HASH),
+            None => (balance0, nonce0, code0),
+        };
+        let mut storage = Vec::new();
+        let mut slots: Vec<_> = update.added_storage.iter().collect();
+        slots.sort_by_key(|(slot, _)| **slot);
+        for (slot, after) in slots {
+            let before = before_db
+                .get_storage_slot(update.address, *slot)
+                .map_err(RpcErr::from)?
+                .unwrap_or_default();
+            if before != *after {
+                storage.push(SlotWrite {
+                    slot: format!("{slot:#x}"),
+                    before: to_hex_u256(before),
+                    after: to_hex_u256(*after),
+                });
+            }
+        }
+        let write = AccountWrite {
+            address: update.address,
+            removed: update.removed,
+            balance: pair(to_hex_u256(balance0), to_hex_u256(balance1)),
+            nonce: pair(format!("0x{nonce0:x}"), format!("0x{nonce1:x}")),
+            code_hash: pair(format!("{code0:#x}"), format!("{code1:#x}")),
+            storage,
+        };
+        if write.removed || write.balance.is_some() || write.nonce.is_some() || write.code_hash.is_some() || !write.storage.is_empty() {
+            out.push(write);
         }
     }
+    out.sort_by_key(|w| w.address);
+    Ok(out)
 }
 
